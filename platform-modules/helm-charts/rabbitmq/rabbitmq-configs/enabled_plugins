%% -*- erlang -*-
%%
%% enabled_plugins — Reference / Documented Example
%% =================================================
%%
%% This file tells RabbitMQ which plugins to enable on node start-up.
%% Unlike rabbitmq.conf, RabbitMQ does not ship a large commented
%% "example" version of this file upstream — it is normally a single,
%% short Erlang term generated by `rabbitmq-plugins enable <name>` (or
%% `rabbitmq-plugins set <name1> <name2> ...`), and it typically lives
%% next to rabbitmq.conf (e.g. /etc/rabbitmq/enabled_plugins).
%%
%% This document was assembled for reference: it lists every plugin
%% officially distributed with RabbitMQ (the "tier 1" plugins that
%% ship in the RabbitMQ release archive / packages), each with a
%% one-line description, and then enables ALL of them at the bottom.
%%
%% Docs: https://www.rabbitmq.com/docs/plugins
%%
%% ---------------------------------------------------------------
%% FORMAT
%% ---------------------------------------------------------------
%% The file contains exactly one Erlang term: a list of plugin name
%% atoms, terminated with a period:
%%
%%   [plugin_one,plugin_two].
%%
%% You do NOT normally hand-edit this file. Use instead:
%%   rabbitmq-plugins enable  <plugin_name>
%%   rabbitmq-plugins disable <plugin_name>
%%   rabbitmq-plugins list
%% which update this file for you and, where possible, apply the
%% change live without a node restart.
%%
%% ---------------------------------------------------------------
%% OFFICIALLY DISTRIBUTED ("TIER 1") PLUGINS
%% ---------------------------------------------------------------
%%
%% rabbitmq_auth_backend_ldap        - Authentication/authorisation via an external LDAP server
%% rabbitmq_auth_backend_oauth2      - OAuth 2.0-based authentication and authorisation
%% rabbitmq_auth_backend_http        - Authentication/authorisation via an external HTTP API
%% rabbitmq_auth_mechanism_ssl       - TLS (x.509) certificate-based client authentication
%% rabbitmq_consistent_hash_exchange - Consistent-hashing exchange type for routing
%% rabbitmq_federation                - Cross-cluster / cross-broker federation links
%% rabbitmq_federation_management     - Federation status/visibility in the management UI
%% rabbitmq_jms_topic_exchange        - Exchange type used by the RabbitMQ JMS client
%% rabbitmq_management                - HTTP-based management API and browser-based UI
%% rabbitmq_management_agent          - Stats/metrics agent required by rabbitmq_management
%% rabbitmq_mqtt                      - MQTT protocol plugin
%% rabbitmq_prometheus                 - Prometheus metrics exporter/scrape endpoint
%% rabbitmq_sharding                   - Automatic partitioning ("sharding") of queues
%% rabbitmq_shovel                     - Reliable message forwarding between brokers
%% rabbitmq_shovel_management          - Shovel status/visibility in the management UI
%% rabbitmq_stomp                      - STOMP protocol plugin
%% rabbitmq_stream                     - RabbitMQ Stream protocol plugin
%% rabbitmq_stream_management          - Stream status/visibility in the management UI
%% rabbitmq_top                        - Per-process resource usage reporting (debugging)
%% rabbitmq_tracing                    - Message-flow tracing for debugging
%% rabbitmq_trust_store                 - Dynamic X.509 certificate trust-store management
%% rabbitmq_web_dispatch                - Shared HTTP listener infrastructure used by web plugins
%% rabbitmq_web_mqtt                    - MQTT over WebSockets
%% rabbitmq_web_mqtt_examples           - Sample MQTT-over-WebSockets application
%% rabbitmq_web_stomp                   - STOMP over WebSockets
%% rabbitmq_web_stomp_examples          - Sample STOMP-over-WebSockets application
%%
%% ---------------------------------------------------------------
%% RESULTING FILE (all of the above enabled)
%% ---------------------------------------------------------------
%% NOTE: enabling every plugin at once is NOT a recommended production
%% configuration — it's provided here purely as a complete reference.
%% In practice you should only enable the plugins you actually use.

[rabbitmq_auth_backend_ldap,
 rabbitmq_auth_backend_oauth2,
 rabbitmq_auth_backend_http,
 rabbitmq_auth_mechanism_ssl,
 rabbitmq_consistent_hash_exchange,
 rabbitmq_federation,
 rabbitmq_federation_management,
 rabbitmq_jms_topic_exchange,
 rabbitmq_management,
 rabbitmq_management_agent,
 rabbitmq_mqtt,
 rabbitmq_prometheus,
 rabbitmq_sharding,
 rabbitmq_shovel,
 rabbitmq_shovel_management,
 rabbitmq_stomp,
 rabbitmq_stream,
 rabbitmq_stream_management,
 rabbitmq_top,
 rabbitmq_tracing,
 rabbitmq_trust_store,
 rabbitmq_web_dispatch,
 rabbitmq_web_mqtt,
 rabbitmq_web_mqtt_examples,
 rabbitmq_web_stomp,
 rabbitmq_web_stomp_examples].

